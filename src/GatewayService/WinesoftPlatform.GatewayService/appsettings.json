{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "https://winesoft-frontend.vercel.app,https://winesoft-platform.onrender.com,http://localhost:5173"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "api/v1/auth/{**remainder}" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "api/v1/inventory/{**remainder}" }
        ]
      },
      "purchases-route": {
        "ClusterId": "purchase-cluster",
        "Match": {
          "Path": "/api/purchases/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "api/v1/purchase-orders/{**remainder}" }
        ]
      },
      "profiles-route": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/profiles/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "api/v1/profiles/{**remainder}" }
        ]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/analytics/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "api/v1/analytics/{**remainder}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://inventory-service:8080"
          }
        }
      },
      "purchase-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://purchase-service:8080"
          }
        }
      },
      "profiles-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://profiles-service:8080"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://analytics-service:8080"
          }
        }
      }
    }
  }
}
